# Copy to .env (never commit .env). Pick your own values.
N360_CH_PASSWORD=change-me-loader
GRAFANA_CH_PASSWORD=change-me-grafana-readonly
GRAFANA_ADMIN_PASSWORD=change-me-admin
# ClickHouse data source plugin version, e.g. 4.x.y: latest from grafana.com/grafana/plugins/grafana-clickhouse-datasource.
# Empty installs the latest at first start, which is not reproducible. Set it once the first start works.
GRAFANA_CH_PLUGIN_VERSION=
