# Copy to .env (never commit .env). Pick your own values.
N360_CH_PASSWORD=change-me-loader
GRAFANA_CH_PASSWORD=change-me-grafana-readonly
GRAFANA_ADMIN_PASSWORD=change-me-admin
# ClickHouse data source plugin version. 4.23.5 = latest on 24 Nov 2026 (released 10 Nov); check grafana.com/grafana/plugins/grafana-clickhouse-datasource.
# Empty installs whatever is latest at start, which is not reproducible.
GRAFANA_CH_PLUGIN_VERSION=4.23.5
