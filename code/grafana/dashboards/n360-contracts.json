    {
      "id": 4,
      "title": "Pooled entitlements",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "One entitlement shared by several lines of one account. Lines in a pool are never compared with the billed amount one by one.\n\n**Source:** consumption_mapping.json \"pools\", via n360.v_line_pace  \n**Filter:** Customer  \n**Window:** Used: the pooled lines, each from its start date to the data-through day",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT a.display_name AS Customer, pc.label AS Pool, pc.billed AS Billed, pc.used AS Used,\n               pc.pct_billed AS `% of billed`, pc.pct_term AS `% of term`, pc.pace AS Pace,\n               concat(concat(toString(toDayOfMonth(pc.start_date)), ' ', formatDateTime(pc.start_date, '%b %Y')), ' to ', concat(toString(toDayOfMonth(pc.end_date)), ' ', formatDateTime(pc.end_date, '%b %Y'))) AS Term, pc.account AS account\n        FROM n360.v_line_pace AS pc INNER JOIN n360.account AS a ON a.account = pc.account\n        WHERE pc.entitlement = 'pool' AND pc.account IN (${account:singlequote})",
          "refId": "A"
        }
      ],
