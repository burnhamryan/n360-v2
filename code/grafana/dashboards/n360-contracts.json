    {
      "id": 5,
      "title": "Daily use per contract line",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Daily contract measure per line (conversations for rules that bill every conversation, billable for meaningful-engagement rules, engaged otherwise). Not measurable and not implemented lines have no usage and are left out. Days not read show as gaps, not zero.\n\n**Source:** n360.line_day with n360.contract_line  \n**Filter:** Customer; measured contract lines  \n**Window:** dashboard time range, per day",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(d.day) AS time, concat(a.display_name, ' \u00b7 ', concat(l.channel, if(l.sheet_customer != l.account, concat(' (', l.sheet_customer, ')'), ''))) AS line, d.measured AS used\n        FROM n360.line_day AS d INNER JOIN n360.contract_line AS l ON l.series_key = d.series_key\n        INNER JOIN n360.account AS a ON a.account = l.account\n        WHERE d.kind = 'line' AND d.account IN (${account:singlequote}) AND l.measure NOT IN ('not measurable', 'not implemented') AND $__dateFilter(d.day)\n        ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "displayName": "${__field.labels.line}",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Containment per VA (weekly)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "containment = 1 - handoffs / engaged conversations, per VA and week. One line per VA, so channels are never combined. VAs whose handoffs are not read (conversation records reader) are not shown, rather than shown as zero.\n\n**Source:** the platform daily conversation aggregate table (n360.va_day, n360.va)  \n**Filter:** Customer; VAs with handoff data; weeks with engaged conversations  \n**Window:** dashboard time range, by week (Monday start)",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(toMonday(d.day)) AS time, concat(v.va_name, ' (', arrayStringConcat(v.channels, ', '), ')') AS va,\n               1 - sum(d.handoffs) / sum(d.engaged) AS containment\n        FROM n360.va_day AS d INNER JOIN n360.va AS v ON v.bot_id = d.bot_id\n        WHERE d.account IN (${account:singlequote}) AND d.handoffs IS NOT NULL AND $__dateFilter(d.day)\n        GROUP BY time, va HAVING sum(d.engaged) > 0 ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "displayName": "${__field.labels.va}",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    }
