    {
      "id": 8,
      "title": "Conversations per week, last 26 weeks",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Each customer's conversations per complete week (Monday to Sunday), one line per customer, in shades of one colour (customers are not statuses). A week with an unread day is a gap. Hover for values.\n\n**Source:** n360.va_day  \n**Filter:** CSM  \n**Window:** the 26 complete weeks to the data-through day",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(toMonday(d.day)) AS time, a.display_name AS customer,\n               if(countIf(d.conversations IS NULL) > 0, NULL, sum(d.conversations)) AS conversations\n        FROM n360.va_day AS d INNER JOIN n360.account AS a ON a.account = d.account\n        WHERE d.account IN (SELECT account FROM n360.account WHERE csm_rocketlane IN (${csm:singlequote})) AND d.day > (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') - 182\n          AND toMonday(d.day) + 6 <= (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded')\n        GROUP BY time, customer ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "displayName": "${__field.labels.customer}",
          "custom": {
            "lineWidth": 2,
            "spanNulls": false,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "color": {
            "mode": "shades",
            "fixedColor": "#7F9CC0"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "timeFrom": "200d"
    },
    {
      "id": 9,
      "title": "VAs: last 30 days against the 30 before",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Every VA of the chosen CSMs' customers, flagged ones first. Containment is per VA, never across channels; \"Not reported yet\" where handoffs are not read. Flags: conversations down 10%+, containment down 3+ points (proposed). Click a VA or a customer to open it.\n\n**Source:** n360.v_va_change (n360.va_day)  \n**Filter:** CSM  \n**Window:** the 60 days to the data-through day",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT c.va AS VA, a.display_name AS Customer, c.convs_30 AS `Conversations, 30 days`,\n               c.convs_change_pct AS `vs previous 30`, c.containment_30 AS Containment,\n               c.containment_change_pts AS `Change (points)`,\n               arrayStringConcat(arrayFilter(x -> x != '', [if(c.convs_down, 'Conversations down', ''),\n                                                            if(c.containment_down, 'Containment down', '')]), ' \u00b7 ') AS Flag,\n               concat('/d/n360-va?var-account=', c.account, '&var-va=', toString(c.bot_id)) AS drill, c.account AS account\n        FROM n360.v_va_change AS c INNER JOIN n360.account AS a ON a.account = c.account\n        WHERE a.csm_rocketlane IN (${csm:singlequote})\n        ORDER BY c.convs_down OR c.containment_down DESC, abs(ifNull(c.convs_change_pct, 0)) DESC",
          "refId": "A"
        }
      ],
