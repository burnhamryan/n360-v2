  "panels": [
    {
      "id": 1,
      "title": "In one sentence",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "For the chosen CSMs: customers, lines below pace, VAs whose conversations fell 10% or more (last 30 days against the 30 before; proposed, n360.settings), and the biggest change in conversations of a VA with at least 300 conversations in the previous 30 days.\n\n**Source:** n360.v_contract_status, n360.v_va_change  \n**Filter:** CSM  \n**Window:** the 60 days to the data-through day",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "WITH (SELECT argMax(concat(va, ' conversations ', if(convs_change_pct < 0, 'down ', 'up '),\n                                   toString(abs(toInt32(round(convs_change_pct)))), '%'), abs(convs_change_pct))\n              FROM n360.v_va_change WHERE account IN (SELECT account FROM n360.account WHERE csm_rocketlane IN (${csm:singlequote})) AND convs_change_pct IS NOT NULL AND convs_prev_30 >= 300) AS biggest\n        SELECT concat(concat(toString((SELECT count() FROM n360.account WHERE account IN (SELECT account FROM n360.account WHERE csm_rocketlane IN (${csm:singlequote})))), if((SELECT count() FROM n360.account WHERE account IN (SELECT account FROM n360.account WHERE csm_rocketlane IN (${csm:singlequote}))) = 1, ' customer', ' customers')), ' \u00b7 ',\n                      toString((SELECT countIf(status = 'below pace') FROM n360.v_contract_status WHERE account IN (SELECT account FROM n360.account WHERE csm_rocketlane IN (${csm:singlequote})))), ' lines below pace \u00b7 ',\n                      toString((SELECT countIf(convs_down) FROM n360.v_va_change WHERE account IN (SELECT account FROM n360.account WHERE csm_rocketlane IN (${csm:singlequote})))), ' VAs with conversations down 10%+',\n                      if(biggest = '', '', concat(' \u00b7 biggest change: ', biggest))) AS sentence",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Nothing loaded yet",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
