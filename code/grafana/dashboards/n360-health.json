      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "VAs whose conversations in the last 30 days are 10% or more below the 30 days before (proposed, n360.settings health_convs_down_pct). A window with an unread day is not compared.\n\n**Source:** n360.v_va_change  \n**Filter:** CSM  \n**Window:** the 60 days to the data-through day",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT countIf(convs_down) AS `last 30 days against the 30 before` FROM n360.v_va_change WHERE account IN (SELECT account FROM n360.account WHERE csm_rocketlane IN (${csm:singlequote}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
