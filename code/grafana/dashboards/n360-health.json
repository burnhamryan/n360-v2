    {
      "id": 3,
      "title": "Lines below pace",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Contract lines and pools more than 10 points behind their term (renewal risks included).\n\n**Source:** n360.v_status_night  \n**Filter:** CSM  \n**Window:** the last 30 stored nights",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "WITH nightly AS (SELECT data_date AS night, toUInt64(countIf(status = 'below pace')) AS value FROM n360.v_status_night\n               WHERE account IN (SELECT account FROM n360.account WHERE csm_rocketlane IN (${csm:singlequote})) GROUP BY night),\n             (SELECT max(night) FROM nightly) AS newest,\n             (SELECT max(night) FROM nightly WHERE night <= newest - 30) AS ref_30,\n             (SELECT min(night) FROM nightly) AS oldest,\n             if(ref_30 IS NULL OR ref_30 = toDate(0), if(oldest < newest, oldest, NULL), ref_30) AS ref,\n             (SELECT any(value) FROM nightly WHERE night = newest) AS v_now,\n             (SELECT any(value) FROM nightly WHERE night = ref) AS v_then\n        SELECT toDateTime(night) AS time, value, if(ref IS NULL, 'no earlier night stored', concat(multiIf(v_now > v_then, concat('+', toString(v_now - v_then)), v_now < v_then, concat('\u2212', toString(v_then - v_now)), 'no change'), ' since ', toString(toDayOfMonth(ref)), ' ', formatDateTime(ref, '%b'))) AS change\n        FROM nightly WHERE night > newest - 30 ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "displayName": "${__field.labels.change}",
          "color": {
            "mode": "fixed",
            "fixedColor": "#7F9CC0"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "showPercentChange": false,
        "text": {
          "titleSize": 13,
          "valueSize": 34
        }
      },
      "links": [
        {
          "title": "Contracts: below pace",
          "url": "/d/n360-contracts?var-status=below pace&var-status=renewal risk"
        }
      ],
      "timeFrom": "35d",
      "hideTimeOverride": true,
      "n360Metric": "lines below pace"
    },
    {
