        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 13,
          "valueSize": 34
        }
      }
    },
