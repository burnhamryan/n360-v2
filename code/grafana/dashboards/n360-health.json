          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT if((SELECT count() FROM n360.ps_ticket) = 0, NULL, countIf(status = 'open')) AS `priority not exported yet`\n        FROM n360.ps_ticket WHERE account IN (SELECT account FROM n360.account WHERE csm_rocketlane IN (${csm:singlequote}))",
          "refId": "A"
        }
      ],
