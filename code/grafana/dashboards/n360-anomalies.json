        "uid": "n360-clickhouse"
      },
      "description": "Settled flags per week and what reviews found. A low share of real flags means the thresholds (n360.settings) flag too much; tuned monthly from these outcomes (05). All customers.\n\n**Source:** n360.v_flag_quality (n360.v_anomaly_review)  \n**Filter:** settled flags  \n**Window:** dashboard time range, by week",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toString(week) AS `Week of`, flags AS Flags, reviewed AS Reviewed, real AS Real, expected AS Expected,\n               data_issue AS `Data issue`, pct_real_of_reviewed AS `Real, of reviewed`\n        FROM n360.v_flag_quality WHERE $__dateFilter(week) ORDER BY week DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Real, of reviewed"
            },
            "properties": [
