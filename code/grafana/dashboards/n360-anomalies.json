        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(toMonday(day)) AS time, countIf(kind IN ('drop', 'went silent')) AS `Drops and silences`,\n               countIf(kind = 'spike') AS Spikes\n        FROM n360.v_va_day_anomaly WHERE account IN (${account:singlequote}) AND NOT provisional AND $__dateFilter(day)\n        GROUP BY time ORDER BY time",
          "refId": "A"
        }
