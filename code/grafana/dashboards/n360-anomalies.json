    {
      "id": 6,
      "title": "Same day, several customers",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Settled days when 3 or more customers were flagged in the same direction: one event (for example an industry-wide disruption), not separate customer stories.\n\n**Source:** n360.v_anomaly_events  \n**Filter:** Customer  \n**Window:** dashboard time range, settled days",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(toString(toDayOfMonth(e.day)), ' ', formatDateTime(e.day, '%b %Y')) AS Day, e.direction AS Direction, e.accounts AS Customers, e.vas AS VAs,\n               arrayStringConcat(e.account_list, ', ') AS Which\n        FROM n360.v_anomaly_events AS e\n        WHERE arrayExists(x -> x IN (${account:singlequote}), e.account_list) AND $__dateFilter(e.day)\n        ORDER BY e.day DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No cross-account events"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Day"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Direction"
            },
            "properties": [
              {
