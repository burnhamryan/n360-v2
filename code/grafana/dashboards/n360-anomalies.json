{
  "uid": "n360-anomalies",
  "title": "N360 \u00b7 Anomalies",
  "tags": [
    "n360"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Customer",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "n360-clickhouse"
        },
        "query": "SELECT account FROM n360.account ORDER BY account",
        "definition": "SELECT account FROM n360.account ORDER BY account",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "kind",
        "label": "Kind",
        "type": "custom",
        "query": "Drops and silences : drops, Spikes : spikes",
        "options": [
          {
            "text": "Drops and silences",
            "value": "drops",
            "selected": true
          },
          {
            "text": "Spikes",
            "value": "spikes",
            "selected": false
          }
        ],
        "current": {
          "text": "Drops and silences",
          "value": "drops"
        },
        "multi": false,
        "includeAll": false
      },
      {
        "name": "provisional",
        "label": "Include provisional",
        "type": "custom",
        "query": "No : no, Yes : yes",
        "options": [
          {
            "text": "No",
            "value": "no",
            "selected": true
          },
          {
            "text": "Yes",
            "value": "yes",
            "selected": false
          }
        ],
        "current": {
          "text": "No",
          "value": "no"
        },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Data through",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Last day included in this load (the nightly window ends at 23:59 UTC that day).\n\n**Source:** n360.runs, written by load.py only after every data check passes  \n**Filter:** loaded runs only; the latest  \n**Window:** the latest load",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT formatDateTime(window_end, '%e %b %Y') AS data_through\n        FROM n360.runs WHERE status = 'loaded' ORDER BY loaded_at DESC, data_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "links": [
            {
              "title": "Pipeline health",
              "url": "/d/n360-pipeline?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Last night",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Result of the latest nightly run. A stopped night leaves the previous good night on screen.\n\n**Source:** n360.runs (load.py writes one row per night, loaded or not)  \n**Filter:** none  \n**Window:** the latest run",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toString(status) AS status FROM n360.runs ORDER BY loaded_at DESC, data_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [
            {
              "type": "value",
              "options": {
                "loaded": {
                  "text": "Loaded",
                  "color": "green",
                  "index": 0
                },
                "failed_checks": {
                  "text": "Stopped: data checks failed",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Flags, 7 settled days",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "VA-days flagged on the 7 newest settled days, and flags on the newest 3 days (provisional).\n\n**Source:** n360.v_va_day_anomaly  \n**Filter:** Customer  \n**Window:** the 7 newest settled days; provisional = the newest 3 days",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT countIf(kind = 'drop' AND NOT provisional AND day >= (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') - 9) AS Drops, countIf(kind = 'went silent' AND NOT provisional AND day >= (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') - 9) AS Silences,\n               countIf(kind = 'spike' AND NOT provisional AND day >= (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') - 9) AS Spikes, countIf(kind != 'normal' AND provisional) AS Provisional\n        FROM n360.v_va_day_anomaly WHERE account IN (${account:singlequote})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      }
    },
    {
      "id": 4,
      "title": "Distance from normal, flagged VAs",
      "type": "state-timeline",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Each VA flagged in the last 30 days, day by day, coloured by distance from its normal: red = flag (z of -4 or lower, or silent), dark red = -4 to -2, grey = normal, dark blue = 2 to 4, blue = spike (4 or higher). Provisional days (newest 3) are faded. Days not scored are blank.\n\n**Source:** n360.v_anomaly_heat (n360.v_va_day_anomaly)  \n**Filter:** Customer; VAs with a flag; Include provisional  \n**Window:** the 30 days to the data-through day",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(h.day) AS time, concat(h.va_name, ' \u00b7 ', a.display_name) AS va,\n               toInt8(h.band + if(h.provisional, 10, 0)) AS band\n        FROM n360.v_anomaly_heat AS h INNER JOIN n360.account AS a ON a.account = h.account\n        WHERE h.account IN (${account:singlequote}) AND h.day > (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') - 30\n          AND h.bot_id IN (SELECT bot_id FROM n360.v_va_day_anomaly\n                           WHERE kind != 'normal' AND day > (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') - 30 AND (NOT provisional OR ${provisional:singlequote} = 'yes'))\n        ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-2": {
                  "text": "Drop or silent",
                  "color": "red",
                  "index": 0
                },
                "8": {
                  "text": "Drop or silent (provisional)",
                  "color": "rgba(242, 73, 92, 0.35)",
                  "index": 1
                },
                "-1": {
                  "text": "Low (z -4 to -2)",
                  "color": "dark-red",
                  "index": 2
                },
                "9": {
                  "text": "Low (z -4 to -2) (provisional)",
                  "color": "rgba(196, 22, 42, 0.35)",
                  "index": 3
                },
                "0": {
                  "text": "Normal",
                  "color": "#5a5a5a",
                  "index": 4
                },
                "10": {
                  "text": "Normal (provisional)",
                  "color": "rgba(90, 90, 90, 0.35)",
                  "index": 5
                },
                "1": {
                  "text": "High (z 2 to 4)",
                  "color": "dark-blue",
                  "index": 6
                },
                "11": {
                  "text": "High (z 2 to 4) (provisional)",
                  "color": "rgba(31, 96, 196, 0.35)",
                  "index": 7
                },
                "2": {
                  "text": "Spike",
                  "color": "blue",
                  "index": 8
                },
                "12": {
                  "text": "Spike (provisional)",
                  "color": "rgba(87, 148, 242, 0.35)",
                  "index": 9
                }
              }
            }
          ],
          "displayName": "${__field.labels.va}",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8e8e"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": false,
        "rowHeight": 0.85,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "n360MayBeEmpty": "no VA flagged in the last 30 days",
      "timeFrom": "35d"
    },
    {
      "id": 5,
      "title": "Anomaly feed",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Every flagged VA-day of the chosen kind in the time range, with its review outcome (real / expected / data issue, or \"Not reviewed\"). Reviews are recorded with code/review_anomaly.py. Click a VA to open it.\n\n**Source:** n360.v_anomaly_review (n360.v_va_day_anomaly, n360.anomaly_log)  \n**Filter:** Customer; Kind; Include provisional  \n**Window:** dashboard time range",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(toString(toDayOfMonth(f.day)), ' ', formatDateTime(f.day, '%b %Y')) AS Day, ac.display_name AS Customer, concat(v.va_name, ' (', arrayStringConcat(v.channels, ', '), ')') AS VA, f.actual AS Actual,\n               f.expected AS Expected, f.z AS z, f.kind AS Kind, if(f.provisional, 'Provisional', 'Settled') AS Status,\n               CAST(f.outcome, 'Nullable(String)') AS Review, f.note AS Note,\n               concat('/d/n360-va?var-account=', f.account, '&var-va=', toString(f.bot_id)) AS drill\n        FROM n360.v_anomaly_review AS f INNER JOIN n360.va AS v ON v.bot_id = f.bot_id\n        INNER JOIN n360.account AS ac ON ac.account = f.account\n        WHERE f.account IN (${account:singlequote}) AND if(${kind:singlequote} = 'spikes', f.kind = 'spike', f.kind IN ('drop', 'went silent')) AND (NOT f.provisional OR ${provisional:singlequote} = 'yes') AND $__dateFilter(f.day)\n        ORDER BY f.day DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No flags of this kind"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "drill"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Actual"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Expected"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "z"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Note"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Review"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "real": {
                        "text": "Real",
                        "color": "red",
                        "index": 0
                      },
                      "expected": {
                        "text": "Expected",
                        "color": "green",
                        "index": 1
                      },
                      "data issue": {
