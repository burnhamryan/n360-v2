      "id": 7,
      "title": "Settled flags per week",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Settled flags per week (Monday start), drops and silences apart from spikes.\n\n**Source:** n360.v_va_day_anomaly  \n**Filter:** Customer; settled days  \n**Window:** dashboard time range, by week",
      "gridPos": {
        "x": 12,
