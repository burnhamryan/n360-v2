  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "In one sentence",
      "description": "Newest night the sources were pulled (by the Claude nightly or by code), the newest ClickHouse load, and the runner's latest job. Sources: n360.ops_night and n360.ops_job (written by the local runner), n360.runs (load.py).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(\n          'Last night pulled: ', ifNull((SELECT any(night) FROM (SELECT night FROM n360.ops_night FINAL\n                                  WHERE claude_result LIKE 'published%' OR code_result = 'complete' ORDER BY night DESC LIMIT 1)), 'none on record'),\n          ' \u00b7 last load: ', ifNull((SELECT concat(toString(argMax(data_date, loaded_at)), ' ', toString(argMax(status, loaded_at))) FROM n360.runs), 'none'),\n          ' \u00b7 runner: ', ifNull((SELECT concat(argMax(action, started), ' ', argMax(state, started)) FROM n360.ops_job FINAL), 'no job yet')) AS sentence",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
