    {
      "id": 8,
      "type": "table",
      "title": "Nights: what ran",
      "description": "One row per pipeline night, newest first. Claude nightly: published (version) or why it stopped. Code pull: run_nightly.py. Export: row counts written. In ClickHouse: whether that export loaded. A missing night = no run that day.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT n.night AS Night, n.claude_result AS `Claude nightly`, n.code_result AS `Code pull`,\n               if(n.export_run_id = '', '', n.export_counts) AS `Export`,\n               multiIf(n.export_run_id = '', '', r.status = 'loaded', 'loaded', r.status = 'failed_checks',\n                       concat('refused by a check: ', arrayStringConcat(r.checks_failed, ', ')), 'not loaded yet') AS `In ClickHouse`\n        FROM (SELECT * FROM n360.ops_night FINAL) AS n\n        LEFT JOIN (SELECT toString(run_id) AS rid, toString(argMax(status, loaded_at)) AS status, argMax(checks_failed, loaded_at) AS checks_failed\n                   FROM n360.runs GROUP BY rid) AS r ON r.rid = n.export_run_id\n        ORDER BY n.night DESC LIMIT 30",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Claude nightly"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(published|loaded|done|complete).*",
                      "result": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(stopped|failed|refused).*",
                      "result": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(running|not loaded yet|export only|ran).*",
                      "result": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Code pull"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(published|loaded|done|complete).*",
                      "result": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
