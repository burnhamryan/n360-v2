    {
      "id": 9,
      "type": "table",
      "title": "Runner jobs",
      "description": "Every job the runner started. Click a job id for its full log (runner page, new tab).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT job_id, started AS `Started (UTC)`, action AS Action, state AS State,\n               if(finished IS NULL, '', concat(toString(dateDiff('minute', started, finished)), ' min')) AS Took,\n               exit_code AS `Exit`, last_line AS `Last line`\n        FROM n360.ops_job FINAL ORDER BY started DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(published|loaded|done|complete).*",
                      "result": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(stopped|failed|refused).*",
                      "result": {
                        "color": "red",
                        "index": 1
                      }
                    }
