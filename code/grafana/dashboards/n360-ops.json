    {
      "id": 3,
      "type": "text",
      "title": "Actions",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 6
      },
      "description": "Buttons for the local runner on this Mac (127.0.0.1:8099). It runs only these three jobs, one at a time.",
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;flex-wrap:wrap;gap:12px;align-items:stretch\">\n  <a href=\"http://127.0.0.1:8099/confirm?action=pull\" target=\"_blank\" rel=\"noopener\" style=\"flex:1 1 220px;padding:14px 16px;border-radius:4px;background:#3d71d9;color:#fff;text-decoration:none;font-weight:600\">\n    &#9654; Run the full nightly<br><span style=\"font-weight:400;font-size:12px\">Pull from every source (VPN needed, about an hour), export, load into ClickHouse</span></a>\n  <a href=\"http://127.0.0.1:8099/confirm?action=export\" target=\"_blank\" rel=\"noopener\" style=\"flex:1 1 220px;padding:14px 16px;border-radius:4px;background:#22252b;border:1px solid #2f333b;color:#ccccdc;text-decoration:none;font-weight:600\">\n    &#8635; Export and load<br><span style=\"font-weight:400;font-size:12px\">Rebuild the export for the newest pulled night, then load it</span></a>\n  <a href=\"http://127.0.0.1:8099/confirm?action=load\" target=\"_blank\" rel=\"noopener\" style=\"flex:1 1 220px;padding:14px 16px;border-radius:4px;background:#22252b;border:1px solid #2f333b;color:#ccccdc;text-decoration:none;font-weight:600\">\n    &#8681; Load new exports<br><span style=\"font-weight:400;font-size:12px\">Load any export not yet in ClickHouse (no VPN needed)</span></a>\n  <a href=\"http://127.0.0.1:8099/\" target=\"_blank\" rel=\"noopener\" style=\"flex:0 1 160px;padding:14px 16px;border-radius:4px;background:#22252b;border:1px solid #2f333b;color:#ccccdc;text-decoration:none;font-weight:600\">\n    Open runner<br><span style=\"font-weight:400;font-size:12px\">Live log of the current job</span></a>\n</div>\n<p style=\"font-size:12px;color:#9fa3ad;margin-top:10px\">Each button opens a confirm page in a new tab; nothing starts until you press Start there.\nIf a button shows \"can't connect\", the runner isn't running: in Terminal, from the pipeline folder,\n<code>~/Documents/Github/n360/.venv/bin/python ops_runner.py</code></p>"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Runner: latest job",
      "description": "State and kind of the newest runner job. Source: n360.ops_job.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT if(count() = 0, NULL, concat(argMax(state, started), ' \u00b7 ', argMax(action, started))) AS s FROM n360.ops_job FINAL",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^(published|loaded|done|complete).*",
                "result": {
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^(stopped|failed|refused).*",
                "result": {
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^(running|not loaded yet|export only|ran).*",
                "result": {
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
