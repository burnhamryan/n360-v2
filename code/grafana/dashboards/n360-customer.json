    },
    {
      "id": 9,
      "title": "Pooled entitlement",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "One billed amount shared by several lines of this customer. Use is compared with billed only at the pool; each line's own use is shown for information, never against billed. Shown only for customers with a pool.\n\n**Source:** n360.v_line_pace, n360.v_line_status (consumption_mapping.json \"pools\")  \n**Filter:** Customer  \n**Window:** start date to the data-through day",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT label AS Entitlement, used AS Used, toNullable(billed) AS Billed, pct_billed AS `% of billed`,\n               pace AS Pace, pct_term AS `% of term`\n        FROM (SELECT 0 AS o, label, used, billed, pct_billed, pace, pct_term\n              FROM n360.v_line_pace WHERE account IN (${account:singlequote}) AND entitlement = 'pool'\n              UNION ALL\n              SELECT 1, concat('  ', l.channel, ' (in the pool)'), s.consumed, NULL, NULL, NULL, NULL\n              FROM n360.v_line_status AS s INNER JOIN n360.contract_line AS l ON l.line_key = s.line_key\n              WHERE s.account IN (${account:singlequote}) AND s.pool_id IS NOT NULL)\n        ORDER BY o, label",
          "refId": "A"
