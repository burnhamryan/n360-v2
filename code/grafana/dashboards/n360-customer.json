    {
      "id": 13,
      "title": "Recent anomalies",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Days a VA went silent, dropped (z of -4 or lower) or spiked (4 or higher) against the same weekday over the previous 8 weeks. Provisional days (the newest 3) may still change and never alert.\n\n**Source:** n360.v_va_day_anomaly  \n**Filter:** Customer; flagged days only  \n**Window:** the 30 days to the data-through day",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(toString(toDayOfMonth(a.day)), ' ', formatDateTime(a.day, '%b %Y')) AS Day, concat(v.va_name, ' (', arrayStringConcat(v.channels, ', '), ')') AS VA, a.kind AS Kind, a.actual AS Actual, a.expected AS Expected,\n               a.z AS z, if(a.provisional, 'Provisional', 'Settled') AS Status\n        FROM n360.v_va_day_anomaly AS a INNER JOIN n360.va AS v ON v.bot_id = a.bot_id\n        WHERE a.account IN (${account:singlequote}) AND a.kind != 'normal' AND a.day > (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') - 30\n        ORDER BY a.day DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No flags in the last 30 days"
        },
