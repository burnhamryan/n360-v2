    {
      "id": 10,
      "title": "Used per week, per line",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Each line's contract measure per week, one series per line (never added up across lines). Not measurable and not implemented lines have no usage and are left out. A week with an unread day is a gap. Complete weeks only.\n\n**Source:** n360.line_day with n360.contract_line  \n**Filter:** Customer; measured lines  \n**Window:** dashboard time range, complete weeks (Monday start)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(toMonday(d.day)) AS time, concat(l.channel, if(l.sheet_customer != l.account, concat(' (', l.sheet_customer, ')'), '')) AS line,\n               if(countIf(d.measured IS NULL) > 0, NULL, sum(d.measured)) AS used\n        FROM n360.line_day AS d INNER JOIN n360.contract_line AS l ON l.series_key = d.series_key\n        WHERE d.kind = 'line' AND d.account IN (${account:singlequote}) AND l.measure NOT IN ('not measurable', 'not implemented')\n          AND $__dateFilter(d.day) AND toMonday(d.day) >= toDate($__fromTime) AND toMonday(d.day) + 6 <= (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded')\n        GROUP BY time, line ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "displayName": "${__field.labels.line}",
          "custom": {
            "spanNulls": false,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Containment per VA (weekly)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "containment = 1 - handoffs / engaged conversations, per VA and week. One line per VA, so channels are never combined. VAs whose handoffs are not read (conversation records reader) are not shown, rather than shown as zero.\n\n**Source:** the platform daily conversation aggregate table (n360.va_day, n360.va)  \n**Filter:** Customer; VAs with handoff data; weeks with engaged conversations  \n**Window:** dashboard time range, by week (Monday start)",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(toMonday(d.day)) AS time, concat(v.va_name, ' (', arrayStringConcat(v.channels, ', '), ')') AS va,\n               1 - sum(d.handoffs) / sum(d.engaged) AS containment\n        FROM n360.va_day AS d INNER JOIN n360.va AS v ON v.bot_id = d.bot_id\n        WHERE d.account IN (${account:singlequote}) AND d.handoffs IS NOT NULL AND $__dateFilter(d.day)\n        GROUP BY time, va HAVING sum(d.engaged) > 0 ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "displayName": "${__field.labels.va}",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "VAs",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Every VA of this customer. Containment = 1 - handoffs / engaged, per VA; \"Not reported yet\" where handoffs are not read (conversation records reader), never 0% or 100%. Flags = drops, silences and spikes on settled days; provisional = the newest 3 days. Click a VA to open it.\n\n**Source:** n360.va, n360.va_day, n360.v_va_day_anomaly  \n**Filter:** Customer  \n**Window:** the 30 days to the data-through day",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(v.va_name, ' (', arrayStringConcat(v.channels, ', '), ')') AS VA, toString(v.region) AS Region, toString(v.consumption_source) AS Reader,\n               if(countIf(d.conversations IS NULL) > 0, NULL, sum(d.conversations)) AS `Conversations, 30 days`,\n               if(countIf(d.handoffs IS NOT NULL) = 0, NULL, 1 - sumIf(d.handoffs, d.handoffs IS NOT NULL) / sumIf(d.engaged, d.handoffs IS NOT NULL)) AS `Containment, 30 days`,\n               any(f.n_settled) AS `Flags, 30 days`, any(f.n_provisional) AS `Provisional`,\n               concat('/d/n360-va?var-account=', v.account, '&var-va=', toString(v.bot_id)) AS drill\n        FROM n360.va AS v\n        LEFT JOIN n360.va_day AS d ON d.bot_id = v.bot_id AND d.day > (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') - 30\n        LEFT JOIN (SELECT bot_id, countIf(NOT provisional) AS n_settled, countIf(provisional) AS n_provisional\n                   FROM n360.v_va_day_anomaly WHERE kind != 'normal' AND day > (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') - 30 GROUP BY bot_id) AS f\n               ON f.bot_id = v.bot_id\n        WHERE v.account IN (${account:singlequote})\n        GROUP BY v.bot_id, v.account, v.va_name, v.channels, v.region, v.consumption_source ORDER BY VA",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
