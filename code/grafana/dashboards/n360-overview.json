    {
      "id": 8,
      "title": "Conversations per week, top customers",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Conversations started per week (Monday to Sunday), for the 5 customers with the most conversations in the time range, and every other customer together as Other. Conversations are the platform count, not a contract measure. A week with any day not read shows as a gap, not a lower bar. Only complete weeks. Click a bar to open the customer.\n\n**Source:** n360.va_day (the platform daily conversation aggregate table and the conversation records reader)  \n**Filter:** none (every customer)  \n**Window:** dashboard time range, complete weeks only",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 10,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "WITH top AS (SELECT account FROM n360.va_day WHERE $__dateFilter(day)\n                     GROUP BY account ORDER BY sum(conversations) DESC LIMIT 5)\n        SELECT toDateTime(toMonday(d.day)) AS time,\n               if(d.account IN (SELECT account FROM top), a.display_name, 'Other') AS customer,\n               if(d.account IN (SELECT account FROM top), d.account, '') AS account,\n               if(countIf(d.conversations IS NULL) > 0, NULL, sum(d.conversations)) AS conversations\n        FROM n360.va_day AS d INNER JOIN n360.account AS a ON a.account = d.account\n        WHERE $__dateFilter(d.day) AND toMonday(d.day) >= toDate($__fromTime)\n          AND toMonday(d.day) + 6 <= (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded')\n        GROUP BY time, customer, account ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "displayName": "${__field.labels.customer}",
          "links": [
            {
              "title": "Open customer",
              "url": "/d/n360-customer?var-account=${__field.labels.account}&${__url_time_range}"
            }
          ],
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Use against billed, by line",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Each line and pool: use as % of billed, in its own contract measure. The bar stops at 100%; the number beside it is the true %. % of term beside it (a tick mark on the bar is not available in Grafana OSS). Not measurable, not implemented and unread lines are left out (see Contracts). Click a line to open it; a pool opens its customer.\n\n**Source:** n360.v_line_pace  \n**Filter:** lines and pools with a % of billed  \n**Window:** start date to the data-through day",
      "gridPos": {
        "x": 10,
        "y": 15,
        "w": 14,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT if(l.entitlement = 'pool', l.label, concat(a.display_name, ' \u00b7 ', l.label)) AS Line,\n               l.pct_billed AS `% of billed`, l.pct_billed AS `Used`, l.pct_term AS `% of term`,\n               if(l.entitlement = 'pool',\n                  concat('/d/n360-customer?var-account=', l.account),\n                  concat('/d/n360-line?var-line=', l.line_key, '&var-account=', l.account))\n                   AS drill\n        FROM n360.v_line_pace AS l INNER JOIN n360.account AS a ON a.account = l.account\n        WHERE l.pct_billed IS NOT NULL\n        ORDER BY l.pct_billed DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "drill"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of billed"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of term"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of billed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of term"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
