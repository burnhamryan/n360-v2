{
  "uid": "n360-overview",
  "title": "N360 \u00b7 Overview",
  "tags": [
    "n360"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "period",
        "label": "Period",
        "type": "custom",
        "query": "Week : week, Day : day, Month : month",
        "options": [
          {
            "text": "Week",
            "value": "week",
            "selected": true
          },
          {
            "text": "Day",
            "value": "day",
            "selected": false
          },
          {
            "text": "Month",
            "value": "month",
            "selected": false
          }
        ],
        "current": {
          "text": "Week",
          "value": "week"
        },
        "multi": false,
        "includeAll": false
      }
