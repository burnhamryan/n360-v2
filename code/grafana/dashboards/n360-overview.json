{
  "uid": "n360-overview",
  "title": "N360 \u00b7 Portfolio overview",
  "tags": [
    "n360"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Data through",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Last day included in this load (the nightly window ends at 23:59 UTC that day).\n\n**Source:** n360.runs, written by load.py only after every data check passes  \n**Filter:** loaded runs only; the latest  \n**Window:** the latest load",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT formatDateTime(window_end, '%e %b %Y') AS data_through\n        FROM n360.runs WHERE status = 'loaded' ORDER BY loaded_at DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "links": [
            {
              "title": "Pipeline health",
              "url": "/d/n360-pipeline?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Last night",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Result of the latest nightly run. A stopped night leaves the previous good night on screen.\n\n**Source:** n360.runs (load.py writes one row per night, loaded or not)  \n**Filter:** none  \n**Window:** the latest run",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toString(status) AS status FROM n360.runs ORDER BY loaded_at DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [
            {
              "type": "value",
              "options": {
                "loaded": {
                  "text": "Loaded",
                  "color": "green",
                  "index": 0
                },
                "failed_checks": {
                  "text": "Stopped: data checks failed",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Customers",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Customers in N360, with their contract lines and pooled entitlements. Includes customers with VAs but no contract line.\n\n**Source:** n360.account, n360.contract_line, n360.pool  \n**Filter:** none  \n**Window:** the latest load",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT (SELECT count() FROM n360.account) AS Customers,\n               (SELECT count() FROM n360.contract_line) AS `Contract lines`,\n               (SELECT count() FROM n360.pool) AS Pools",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "text": {
          "titleSize": 12,
          "valueSize": 30
        }
      }
    },
    {
      "id": 4,
      "title": "Lines above billed",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Lines and pools whose use is over the billed amount, each in its own contract measure. A pool is counted once, as the pool; its lines are never compared with billed alone.\n\n**Source:** n360.v_line_pace  \n**Filter:** none (every customer)  \n**Window:** each from its start date to the data-through day",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT countIf(pct_billed > 100) AS above FROM n360.v_line_pace",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "transparent",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000000000000.0,
                "result": {
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "background"
      },
      "links": [
        {
          "title": "Contracts",
          "url": "/d/n360-contracts?${__url_time_range}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Crossing billed in 90 days",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Lines and pools under billed today that the stored forecast says will cross billed within 90 days, before their term ends. Already above billed is counted in \"Lines above billed\".\n\n**Source:** n360.forecast (straight line at the last-30-day rate, never recomputed), via n360.v_line_pace  \n**Filter:** none (every customer)  \n**Window:** next 90 days from the data-through day",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT countIf(days_to_cross BETWEEN 0 AND 90) AS crossing FROM n360.v_line_pace",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "none"
      },
      "links": [
        {
          "title": "Forecast and runway",
          "url": "/d/n360-forecast?${__url_time_range}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Drops or silences, 7 settled days",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "VA-days flagged as a drop (z of -4 or lower) or went silent (0 conversations), on settled days only. Provisional days (the newest 3) are not counted.\n\n**Source:** n360.v_va_day_anomaly, via n360.v_customer_attention  \n**Filter:** none (every customer)  \n**Window:** the 7 newest settled days (data-through minus 9 to minus 3)",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT sum(drops_silences_7d) AS flags FROM n360.v_customer_attention",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "none"
      },
      "links": [
        {
          "title": "Anomalies",
          "url": "/d/n360-anomalies?${__url_time_range}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Customers needing attention",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Customers with a line or pool off pace (red or amber), or a drop or silence on a settled day. Worst line = the customer's most off-pace line or pool (red, then amber, then the larger pace gap). Pace colours are proposed, set in n360.v_line_pace. Sorted red first, then by pace gap. Drops 7d = settled drops or silences in the 7 newest settled days (the newest 3 days are provisional and not counted). Click a customer to open it.\n\n**Source:** n360.v_customer_attention (pace from n360.v_line_pace and n360.forecast; flags from n360.v_va_day_anomaly)  \n**Filter:** red or amber pace, or a settled drop or silence  \n**Window:** use: start date to the data-through day; flags: the 7 newest settled days",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT display_name AS Customer, account, worst_label AS `Worst line`, measure AS Measure,\n               pct_billed AS `% of billed`, pct_term AS `% of term`, pace AS Pace, pace_reason AS Why,\n               multiIf(cross_date IS NOT NULL, concat(toString(toDayOfMonth(cross_date)), ' ', formatDateTime(cross_date, '%b %Y')), pct_billed IS NULL, NULL,\n                       pct_billed > 100, 'Already above billed', 'Not before term end') AS `Crosses billed`,\n               drops_silences_7d AS `Drops 7d`\n        FROM n360.v_customer_attention\n        WHERE pace IN ('red', 'amber') OR drops_silences_7d > 0\n        ORDER BY pace_rank DESC, pace_gap DESC, Customer",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "account"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of billed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of term"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pace"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "red": {
                        "text": "Red",
                        "color": "red",
                        "index": 0
                      },
                      "amber": {
