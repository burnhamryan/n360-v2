    {
      "id": 9,
      "title": "Needs attention",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "At most 8 items, soonest date first: a line or pool over billed, set to exceed (date = when it crosses), at renewal risk, or whose term ended in the last 90 days; or a VA with 1,000+ conversations down 25% or more (last 30 days against the 30 before). Thresholds proposed (n360.settings). Click a customer, a line or a VA to open it; \"View all\" opens Customer health.\n\n**Source:** n360.v_needs_attention (n360.v_contract_status, n360.v_va_change)  \n**Filter:** none (every customer)  \n**Window:** the latest load",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT display_name AS Customer, subject AS `Line or VA`, issue AS Issue, concat(toString(toDayOfMonth(issue_date)), ' ', formatDateTime(issue_date, '%b %Y')) AS `Date`,\n               status AS Status, csm AS CSM, account, drill\n        FROM (SELECT n.*, if(c.renewal_risk, 'renewal risk', n.status) AS status\n              FROM n360.v_needs_attention AS n\n              LEFT JOIN (SELECT full_label, renewal_risk FROM n360.v_contract_status) AS c ON c.full_label = n.subject)\n        ORDER BY issue_date, rank LIMIT 8",
          "refId": "A"
        }
      ],
