    {
      "id": 10,
      "title": "All conversations",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Conversations started per day, week (Monday to Sunday) or month, every VA together. The newest period is drawn faded and labelled \"Still counting\" while it is not over or holds days that may still settle (the newest 3). A period with any day not read is a gap, never a lower bar. Conversations are the platform count, not a contract measure.\n\n**Source:** n360.va_day (the platform daily conversation aggregate and the conversation records reader)  \n**Filter:** none (every customer)  \n**Window:** dashboard time range, by the Period picker",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "WITH (SELECT toDate(max(window_end)) FROM n360.runs WHERE status = 'loaded') AS dt,\n             (SELECT anomaly_provisional_days FROM n360.settings) AS settling\n        SELECT toDateTime(b) AS time,\n               if(partial, NULL, if(countIf(d.conversations IS NULL) > 0, NULL, sum(d.conversations))) AS Conversations,\n               if(partial, if(countIf(d.conversations IS NULL) > 0, NULL, sum(d.conversations)), NULL) AS `Still counting`\n        FROM (SELECT *, multiIf(${period:singlequote} = 'day', day, ${period:singlequote} = 'month', toStartOfMonth(day), toMonday(day)) AS b,\n                     multiIf(${period:singlequote} = 'day', day, ${period:singlequote} = 'month', toLastDayOfMonth(day), toMonday(day) + 6) AS b_end\n              FROM n360.va_day) AS d\n        WHERE 1 AND $__dateFilter(d.day)\n        GROUP BY b, b_end > dt OR b_end > dt - settling AS partial ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 1,
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Conversations"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#7F9CC0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Still counting"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C3D2E6"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
