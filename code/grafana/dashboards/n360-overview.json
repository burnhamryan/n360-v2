  "panels": [
    {
      "id": 1,
      "title": "In one sentence",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Customers with something needing attention (the list below), contract lines and pools whose term ends within 30 days (n360.settings ending_soon_days), and lines at renewal risk (under 50% used with 120 days or fewer left; proposed).\n\n**Source:** n360.v_needs_attention, n360.v_contract_status  \n**Filter:** none (every customer)  \n**Window:** the latest load",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(concat(toString(c), if(c = 1, ' customer needs', ' customers need')), ' attention \u00b7 ',\n                      concat(toString(e), if(e = 1, ' line ends', ' lines end')), ' in the next ', toString(days), ' days \u00b7 ',\n                      toString(r), ' at renewal risk') AS sentence\n        FROM (SELECT (SELECT uniqExact(account) FROM n360.v_needs_attention) AS c,\n                     (SELECT ending_soon_days FROM n360.settings) AS days,\n                     (SELECT countIf(days_left BETWEEN 0 AND days) FROM n360.v_contract_status) AS e,\n                     (SELECT countIf(renewal_risk) FROM n360.v_contract_status) AS r)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Nothing loaded yet",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 17
        }
      }
    },
    {
      "id": 2,
      "title": "Data",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "The last day of usage in this load, and the day it was loaded. Amber when the data is more than 2 days old (n360.settings stamp_stale_days): the numbers are the last good night's. Click for Pipeline health.\n\n**Source:** n360.v_freshness (n360.runs: loaded runs only)  \n**Filter:** none  \n**Window:** the latest load",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(stamp, if(stale, concat(' \u00b7 ', toString(days_old), ' days old'), '')) AS stamp FROM n360.v_freshness",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": ".* days old$",
                "result": {
                  "color": "#F0C25A",
                  "index": 0
                }
              }
            }
          ],
          "links": [
            {
              "title": "Pipeline health",
              "url": "/d/n360-pipeline"
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "valueSize": 13
        }
      }
    },
    {
      "id": 3,
      "title": "Lines over or set to exceed billed",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Contract lines and pools already over billed, or that the stored forecast says will cross billed before their term ends. A pool counts once. The line under the number is the last 30 nights; the change is against 30 nights ago (or the oldest stored night).\n\n**Source:** n360.v_status_night (n360.forecast_history), the same rules as n360.v_contract_status  \n**Filter:** none (every customer)  \n**Window:** the last 30 stored nights",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "WITH nightly AS (SELECT data_date AS night, toUInt64(countIf(status IN ('over billed', 'will exceed'))) AS value FROM n360.v_status_night\n               WHERE 1 GROUP BY night),\n             (SELECT max(night) FROM nightly) AS newest,\n             (SELECT max(night) FROM nightly WHERE night <= newest - 30) AS ref_30,\n             (SELECT min(night) FROM nightly) AS oldest,\n             if(ref_30 IS NULL OR ref_30 = toDate(0), if(oldest < newest, oldest, NULL), ref_30) AS ref,\n             (SELECT any(value) FROM nightly WHERE night = newest) AS v_now,\n             (SELECT any(value) FROM nightly WHERE night = ref) AS v_then\n        SELECT toDateTime(night) AS time, value, if(ref IS NULL, 'no earlier night stored', concat(multiIf(v_now > v_then, concat('+', toString(v_now - v_then)), v_now < v_then, concat('\u2212', toString(v_then - v_now)), 'no change'), ' since ', toString(toDayOfMonth(ref)), ' ', formatDateTime(ref, '%b'))) AS change\n        FROM nightly WHERE night > newest - 30 ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "displayName": "${__field.labels.change}",
          "color": {
            "mode": "fixed",
            "fixedColor": "#7F9CC0"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "showPercentChange": false,
        "text": {
          "titleSize": 13,
          "valueSize": 34
        }
      },
      "links": [
        {
          "title": "Contracts: over or will exceed",
          "url": "/d/n360-contracts?var-status=over billed&var-status=will exceed"
        }
      ],
      "timeFrom": "35d",
      "hideTimeOverride": true,
      "n360Metric": "lines over or will exceed"
    },
    {
      "id": 4,
      "title": "Lines below pace",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Contract lines and pools whose % of billed is more than 10 points behind their % of term (proposed, n360.settings status_pace_pts), renewal risks included.\n\n**Source:** n360.v_status_night (n360.forecast_history)  \n**Filter:** none (every customer)  \n**Window:** the last 30 stored nights",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "WITH nightly AS (SELECT data_date AS night, toUInt64(countIf(status = 'below pace')) AS value FROM n360.v_status_night\n               WHERE 1 GROUP BY night),\n             (SELECT max(night) FROM nightly) AS newest,\n             (SELECT max(night) FROM nightly WHERE night <= newest - 30) AS ref_30,\n             (SELECT min(night) FROM nightly) AS oldest,\n             if(ref_30 IS NULL OR ref_30 = toDate(0), if(oldest < newest, oldest, NULL), ref_30) AS ref,\n             (SELECT any(value) FROM nightly WHERE night = newest) AS v_now,\n             (SELECT any(value) FROM nightly WHERE night = ref) AS v_then\n        SELECT toDateTime(night) AS time, value, if(ref IS NULL, 'no earlier night stored', concat(multiIf(v_now > v_then, concat('+', toString(v_now - v_then)), v_now < v_then, concat('\u2212', toString(v_then - v_now)), 'no change'), ' since ', toString(toDayOfMonth(ref)), ' ', formatDateTime(ref, '%b'))) AS change\n        FROM nightly WHERE night > newest - 30 ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "displayName": "${__field.labels.change}",
          "color": {
            "mode": "fixed",
            "fixedColor": "#7F9CC0"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "showPercentChange": false,
        "text": {
          "titleSize": 13,
          "valueSize": 34
        }
      },
      "links": [
        {
          "title": "Contracts: below pace",
          "url": "/d/n360-contracts?var-status=below pace&var-status=renewal risk"
        }
      ],
      "timeFrom": "35d",
      "hideTimeOverride": true,
      "n360Metric": "lines below pace"
    },
    {
      "id": 5,
      "title": "VAs on V8 or later",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "VAs whose weekly configuration read shows engine V8 or later. The change is against the read 30 days earlier (or the oldest stored). Phase 2 (proposed design, tested on synthetic only): field meanings are open questions in docs/08_DECISIONS.md. Empty until the company export carries these files.\n\n**Source:** n360.va_config_snapshot  \n**Filter:** none (every customer)  \n**Window:** weekly reads, the last 30 days",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "WITH nightly AS (SELECT snapshot_date AS night, toUInt64(countIf(engine_major >= (SELECT engine_current_major FROM n360.settings))) AS value\n        FROM n360.va_config_snapshot GROUP BY night),\n             (SELECT max(night) FROM nightly) AS newest,\n             (SELECT max(night) FROM nightly WHERE night <= newest - 30) AS ref_30,\n             (SELECT min(night) FROM nightly) AS oldest,\n             if(ref_30 IS NULL OR ref_30 = toDate(0), if(oldest < newest, oldest, NULL), ref_30) AS ref,\n             (SELECT any(value) FROM nightly WHERE night = newest) AS v_now,\n             (SELECT any(value) FROM nightly WHERE night = ref) AS v_then\n        SELECT toDateTime(night) AS time, value, if(ref IS NULL, 'no earlier night stored', concat(multiIf(v_now > v_then, concat('+', toString(v_now - v_then)), v_now < v_then, concat('\u2212', toString(v_then - v_now)), 'no change'), ' since ', toString(toDayOfMonth(ref)), ' ', formatDateTime(ref, '%b'))) AS change\n        FROM nightly WHERE night > newest - 30 ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "displayName": "${__field.labels.change}",
          "color": {
            "mode": "fixed",
            "fixedColor": "#7F9CC0"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto",
        "showPercentChange": false,
        "text": {
          "titleSize": 13,
          "valueSize": 34
        }
      },
      "links": [
        {
          "title": "Adoption",
          "url": "/d/n360-adoption?${__url_time_range}"
        }
      ],
      "timeFrom": "35d",
      "hideTimeOverride": true,
      "n360Metric": "vas on v8"
    },
    {
      "id": 6,
      "title": "Customers using 3+ target features",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Customers using at least 3 of the 5 target features in the last 30 days: V8 playbooks run, the authoring tool, the analytics assistant, MCP servers live, supervisory rules on (proposed list; the v1.1 page also counts Testing, Calibration and Recipes, not exported yet). Phase 2 (proposed design, tested on synthetic only): field meanings are open questions in docs/08_DECISIONS.md. Empty until the company export carries these files.\n\n**Source:** n360.v_feature_use  \n**Filter:** none (every customer)  \n**Window:** the 30 days to the data-through day",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT now() AS time, if(countIf(f.n_read > 0) = 0, NULL, toUInt64(countIf(f.n_used >= m))) AS value,\n               concat('of ', toString(countIf(f.n_read > 0)), ' customers \u00b7 history not stored yet') AS change\n        FROM (SELECT account, countIf(used) AS n_used, countIf(used IS NOT NULL) AS n_read FROM n360.v_feature_use\n              GROUP BY account) AS f\n        CROSS JOIN (SELECT target_features_min AS m FROM n360.settings) AS s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "displayName": "${__field.labels.change}",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "titleSize": 13,
          "valueSize": 34
        }
      },
      "links": [
        {
          "title": "Adoption",
          "url": "/d/n360-adoption?${__url_time_range}"
        }
      ],
      "n360Metric": "customers on 3+ features"
    },
    {
      "id": 7,
      "title": "Contract lines by status",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Every contract line and pool (a pool counts once) by its status, as a share of the book. Grey = no reading yet (not built, not measured, billed not recorded, unmapped, under review, not reported). Click a segment to open Contracts filtered to it. Rules: n360.v_contract_status (proposed thresholds in n360.settings).\n\n**Source:** n360.v_contract_status  \n**Filter:** none (every customer)  \n**Window:** the latest load",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT 'Lines and pools' AS Book, countIf(if(renewal_risk, 'renewal risk', status) = 'over billed') AS `Over billed`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'will exceed') AS `Will exceed`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'renewal risk') AS `Renewal risk`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'below pace') AS `Below pace`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'ahead') AS `Ahead`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'on pace') AS `On pace`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'too early') AS `Too early to tell`,\n               countIf(if(renewal_risk, 'renewal risk', status) IN ('under review', 'billed not recorded', 'unmapped', 'not built', 'not measured', 'not read')) AS `No reading yet` FROM n360.v_contract_status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "unit": "locale",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "custom": {
