    {
      "id": 8,
      "title": "Status, last 30 nights",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "The same statuses, night by night, as a share of the lines with a stored forecast (lines with no use or no billed amount have no stored forecast and are left out here).\n\n**Source:** n360.v_status_night (n360.forecast_history)  \n**Filter:** none (every customer)  \n**Window:** the last 30 stored nights",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(data_date) AS time, countIf(if(renewal_risk, 'renewal risk', status) = 'over billed') AS `Over billed`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'will exceed') AS `Will exceed`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'renewal risk') AS `Renewal risk`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'below pace') AS `Below pace`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'ahead') AS `Ahead`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'on pace') AS `On pace`,\n               countIf(if(renewal_risk, 'renewal risk', status) = 'too early') AS `Too early to tell`,\n               countIf(if(renewal_risk, 'renewal risk', status) IN ('under review', 'billed not recorded', 'unmapped', 'not built', 'not measured', 'not read')) AS `No reading yet`\n        FROM n360.v_status_night WHERE data_date > (SELECT max(data_date) FROM n360.v_status_night) - 30\n        GROUP BY time ORDER BY time",
          "refId": "A"
        }
