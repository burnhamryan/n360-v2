{
  "uid": "n360-forecast",
  "title": "N360 \u00b7 Forecast and runway",
  "tags": [
    "n360"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-14d",
    "to": "now+18M"
  },
  "templating": {
    "list": [
      {
        "name": "account",
        "label": "Customer",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "n360-clickhouse"
        },
        "query": "SELECT account FROM n360.account ORDER BY account",
        "definition": "SELECT account FROM n360.account ORDER BY account",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Data through",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Last day included in this load (the nightly window ends at 23:59 UTC that day).\n\n**Source:** n360.runs, written by load.py only after every data check passes  \n**Filter:** loaded runs only; the latest  \n**Window:** the latest load",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT formatDateTime(window_end, '%e %b %Y') AS data_through\n        FROM n360.runs WHERE status = 'loaded' ORDER BY loaded_at DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "links": [
            {
              "title": "Pipeline health",
              "url": "/d/n360-pipeline?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Last night",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Result of the latest nightly run. A stopped night leaves the previous good night on screen.\n\n**Source:** n360.runs (load.py writes one row per night, loaded or not)  \n**Filter:** none  \n**Window:** the latest run",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toString(status) AS status FROM n360.runs ORDER BY loaded_at DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [
            {
              "type": "value",
              "options": {
                "loaded": {
                  "text": "Loaded",
                  "color": "green",
                  "index": 0
                },
                "failed_checks": {
                  "text": "Stopped: data checks failed",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Crossing billed",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Lines and pools under billed today that the stored forecast says will cross billed within 30, 60 and 90 days, before their term ends.\n\n**Source:** n360.forecast via n360.v_line_pace  \n**Filter:** Customer  \n**Window:** from the data-through day",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT countIf(days_to_cross BETWEEN 0 AND 30) AS `In 30 days`,\n               countIf(days_to_cross BETWEEN 0 AND 60) AS `In 60 days`,\n               countIf(days_to_cross BETWEEN 0 AND 90) AS `In 90 days`\n        FROM n360.v_line_pace WHERE account IN (${account:singlequote})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      }
    },
    {
      "id": 4,
      "title": "Above billed",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Lines and pools already over billed (a pool counted once).\n\n**Source:** n360.v_line_pace  \n**Filter:** Customer  \n**Window:** start date to the data-through day",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT countIf(runway = 'above billed') AS above FROM n360.v_line_pace WHERE account IN (${account:singlequote})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "transparent",
                  "index": 0
