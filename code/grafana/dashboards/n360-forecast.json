    {
      "id": 8,
      "title": "Step changes",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Lines whose last-30-day rate is more than 50% away from their term average: rising, falling or stopped. The forecast uses the last 30 days, so a step change moves the runs-out date a lot.\n\n**Source:** n360.forecast via n360.v_line_pace  \n**Filter:** Customer; flagged lines  \n**Window:** last 30 days against the term",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT a.display_name AS Customer, pc.label AS Line, pc.last30_vs_term_pct AS `Last 30 days vs term average`,\n               pc.step_change AS Change\n        FROM n360.v_line_pace AS pc INNER JOIN n360.account AS a ON a.account = pc.account\n        WHERE pc.account IN (${account:singlequote}) AND pc.step_change IS NOT NULL",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No step changes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last 30 days vs term average"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {},
      "n360MayBeEmpty": "no line has a step change"
    },
    {
      "id": 9,
      "title": "Forecast accuracy (MAPE)",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "How far the stored forecast was off: forecasts made 30, 60 and 90 days earlier against what was then used (mean absolute % error; lower is better). The forecast is evaluated as stored, never refitted. Shows once forecasts 30 days old are stored.\n\n**Source:** n360.v_forecast_accuracy (n360.forecast_history)  \n**Filter:** Customer; lines and pools with a billed amount  \n**Window:** every stored night",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT Line, `30 days`, `60 days`, `90 days`, Forecasts FROM (\n            SELECT 0 AS o, concat(a.display_name, ' \u00b7 ', pc.label) AS Line,\n                   anyIf(fa.mape, fa.horizon_days = 30) AS `30 days`, anyIf(fa.mape, fa.horizon_days = 60) AS `60 days`,\n                   anyIf(fa.mape, fa.horizon_days = 90) AS `90 days`, maxIf(fa.forecasts, fa.horizon_days = 30) AS Forecasts\n            FROM n360.v_forecast_accuracy AS fa\n            INNER JOIN n360.v_line_pace AS pc ON pc.series_key = fa.series_key\n            INNER JOIN n360.account AS a ON a.account = fa.account\n            WHERE fa.account IN (${account:singlequote}) GROUP BY Line\n            UNION ALL\n            SELECT 1, 'All lines (weighted by forecasts)',\n                   round(sumIf(mape * forecasts, horizon_days = 30) / sumIf(forecasts, horizon_days = 30), 1),\n                   round(sumIf(mape * forecasts, horizon_days = 60) / sumIf(forecasts, horizon_days = 60), 1),\n                   round(sumIf(mape * forecasts, horizon_days = 90) / sumIf(forecasts, horizon_days = 90), 1),\n                   sumIf(forecasts, horizon_days = 30)\n            FROM n360.v_forecast_accuracy WHERE account IN (${account:singlequote}) HAVING sumIf(forecasts, horizon_days = 30) > 0\n        ) ORDER BY o, Line",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Shows once forecasts 30 days old are stored"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "30 days"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
