    {
      "id": 10,
      "title": "Crossing date drift",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Where each line's crossing date stood 7 and 30 stored nights ago, and how many days it has moved (negative = earlier). Empty where the forecast had no crossing date then (\"Not reported yet\" = no crossing before the term end, or not stored).\n\n**Source:** n360.v_forecast_drift (n360.forecast_history)  \n**Filter:** Customer; lines that cross billed now or did then  \n**Window:** stored nights",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(a.display_name, ' \u00b7 ', pc.label) AS Line,\n               concat(toString(toDayOfMonth(d.cross_now)), ' ', formatDateTime(d.cross_now, '%b %Y')) AS `Crosses billed`, concat(toString(toDayOfMonth(d.cross_7_nights_ago)), ' ', formatDateTime(d.cross_7_nights_ago, '%b %Y')) AS `7 nights ago`,\n               concat(toString(toDayOfMonth(d.cross_30_nights_ago)), ' ', formatDateTime(d.cross_30_nights_ago, '%b %Y')) AS `30 nights ago`, d.moved_7 AS `Moved, 7 nights`,\n               d.moved_30 AS `Moved, 30 nights`\n        FROM n360.v_forecast_drift AS d\n        INNER JOIN n360.v_line_pace AS pc ON pc.series_key = d.series_key\n        INNER JOIN n360.account AS a ON a.account = d.account\n        WHERE d.account IN (${account:singlequote}) ORDER BY ifNull(d.moved_7, 0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
