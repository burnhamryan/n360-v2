              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000000000000.0,
                "result": {
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
