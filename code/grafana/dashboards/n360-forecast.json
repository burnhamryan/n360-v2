    {
      "id": 5,
      "title": "Step changes",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Lines and pools whose last-30-day rate differs from their term average by more than 50% (flagged upstream in the forecast).\n\n**Source:** n360.forecast via n360.v_line_pace  \n**Filter:** Customer  \n**Window:** last 30 days against the term",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT countIf(step_change IS NOT NULL) AS steps FROM n360.v_line_pace WHERE account IN (${account:singlequote})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Runway",
      "type": "state-timeline",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "One lane per line or pool: from the data-through day to the day the stored forecast says it runs out (uses up billed). Red: crosses billed soon (the red window of the pace rule). Blue: crosses billed before its term ends. Grey: runs out only after the term ends; dark after the term end (the change of shade marks the contract end). Lines already above billed, not measurable or not implemented have no runway and are not shown.\n\n**Source:** n360.forecast via n360.v_line_pace  \n**Filter:** Customer; lines with a runs-out date  \n**Window:** from the data-through day forward",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "WITH lanes AS (\n                 SELECT concat(a.display_name, ' \u00b7 ', pc.label) AS lane, pc.data_through AS dt, pc.end_date AS term_end,\n                        pc.exhaust_date AS runs_out,\n                        multiIf(pc.runway = 'crosses soon', 3, pc.runway = 'crosses before term end', 2, 1) AS cat\n                 FROM n360.v_line_pace AS pc INNER JOIN n360.account AS a ON a.account = pc.account\n                 WHERE pc.account IN (${account:singlequote}) AND pc.exhaust_date IS NOT NULL),\n             times AS (SELECT DISTINCT t FROM (SELECT dt AS t FROM lanes UNION ALL SELECT term_end FROM lanes WHERE term_end >= dt\n                                               UNION ALL SELECT runs_out FROM lanes))\n        -- every lane gets a value at every date on the chart, so Grafana never fills a gap\n        SELECT toDateTime(times.t) AS time, lanes.lane AS lane,\n               toUInt8(multiIf(times.t >= lanes.runs_out, 0, times.t >= lanes.term_end, 9, lanes.cat)) AS state\n        FROM lanes CROSS JOIN times\n        ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "",
          "mappings": [
            {
              "type": "value",
              "options": {
                "3": {
                  "text": "Crosses billed soon",
                  "color": "red",
                  "index": 0
                },
                "2": {
                  "text": "Crosses billed before term end",
                  "color": "blue",
                  "index": 1
                },
                "1": {
                  "text": "Runs out after term end",
                  "color": "#8e8e8e",
                  "index": 2
                },
                "9": {
                  "text": "After the term end",
                  "color": "#3d3d3d",
                  "index": 3
                },
                "0": {
                  "text": "Runs out",
                  "color": "transparent",
                  "index": 4
                }
              }
            }
          ],
          "displayName": "${__field.labels.lane}",
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8e8e"
          },
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "alignValue": "left",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Runway by line",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Every line and pool: use, rate (last 30 days / 30), the runs-out date from the stored forecast, and when the term ends. Note carries the forecast flags and says when a term has already ended. Click a line to open it (a pool opens its customer).\n\n**Source:** n360.forecast via n360.v_line_pace  \n**Filter:** Customer  \n**Window:** start date to the data-through day; forecast forward",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(a.display_name, ' \u00b7 ', pc.label) AS Line, pc.measure AS Measure, pc.used AS Used, pc.billed AS Billed,\n               round(pc.rate_per_day) AS `Per day`,\n               multiIf(pc.exhaust_date IS NOT NULL, concat(toString(toDayOfMonth(pc.exhaust_date)), ' ', formatDateTime(pc.exhaust_date, '%b %Y')), pc.runway = 'above billed', 'Already above billed', NULL) AS `Runs out`,\n               concat(toString(toDayOfMonth(pc.end_date)), ' ', formatDateTime(pc.end_date, '%b %Y')) AS `Term ends`, pc.runway AS Runway,\n               trim(BOTH '; ' FROM concat(if(pc.term_ended, 'Term already ended; ', ''), arrayStringConcat(pc.flags, '; '))) AS Note,\n               if(pc.entitlement = 'pool', concat('/d/n360-customer?var-account=', pc.account),\n                  concat('/d/n360-line?var-account=', pc.account, '&var-line=', pc.line_key)) AS drill\n        FROM n360.v_line_pace AS pc INNER JOIN n360.account AS a ON a.account = pc.account\n        WHERE pc.account IN (${account:singlequote}) ORDER BY pc.exhaust_date IS NULL, pc.exhaust_date",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "custom": {
            "align": "auto"
          }
