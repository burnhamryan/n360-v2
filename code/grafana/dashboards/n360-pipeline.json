{
  "uid": "n360-pipeline",
  "title": "N360 \u00b7 Pipeline health",
  "tags": [
    "n360"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Data through",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Last day included in this load (the nightly window ends at 23:59 UTC that day).\n\n**Source:** n360.runs, written by load.py only after every data check passes  \n**Filter:** loaded runs only; the latest  \n**Window:** the latest load",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT formatDateTime(window_end, '%e %b %Y') AS data_through\n        FROM n360.runs WHERE status = 'loaded' ORDER BY loaded_at DESC, data_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Last night",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Result of the latest nightly run. A stopped night leaves the previous good night on screen.\n\n**Source:** n360.runs (load.py writes one row per night, loaded or not)  \n**Filter:** none  \n**Window:** the latest run",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toString(status) AS status FROM n360.runs ORDER BY loaded_at DESC, data_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [
            {
              "type": "value",
              "options": {
                "loaded": {
                  "text": "Loaded",
                  "color": "green",
                  "index": 0
                },
                "failed_checks": {
                  "text": "Stopped: data checks failed",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Nights loaded, last 14",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Nights whose latest attempt loaded, of the last 14 (by data date).\n\n**Source:** n360.runs  \n**Filter:** none  \n**Window:** the 14 nights to the latest run",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 5,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT countIf(status = 'loaded') AS loaded FROM (\n            SELECT data_date, argMax(status, loaded_at) AS status FROM n360.runs GROUP BY data_date)\n        WHERE data_date > (SELECT max(data_date) FROM n360.runs) - 14",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Checks passed, last load",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Data checks the latest run passed, of the 8 in code/checks.sql. Any failure stops the load.\n\n**Source:** n360.runs, code/checks.sql  \n**Filter:** none  \n**Window:** the latest run",
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 5,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(toString(8 - length(checks_failed)), ' of 8') AS checks\n        FROM n360.runs ORDER BY loaded_at DESC, data_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Stale sources",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Sources whose last day is 2 or more days behind the data-through day (proposed thresholds, in n360.v_source_freshness).\n\n**Source:** n360.v_source_freshness  \n**Filter:** none  \n**Window:** the latest load",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT countIf(status != 'green') AS stale FROM n360.v_source_freshness",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "transparent",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000000000000.0,
                "result": {
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 6,
      "title": "Nightly loads, last 14 nights",
      "type": "state-timeline",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "One block per night (by data date): green loaded, red stopped by a data check (the previous night stayed on screen), grey no run. A run that errored before logging (loader exit 2) is not recorded in n360.runs and shows as no run.\n\n**Source:** n360.runs  \n**Filter:** none  \n**Window:** the 14 nights to the latest run",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(n.night) AS time,\n               toNullable(multiIf(r.status = 'loaded', 1, r.status = 'failed_checks', 2, 0)) AS `Nightly load`\n        FROM (SELECT (SELECT max(data_date) FROM n360.runs) - number AS night FROM numbers(14)) AS n\n        LEFT JOIN (SELECT data_date, toString(argMax(status, loaded_at)) AS status FROM n360.runs GROUP BY data_date) AS r\n               ON r.data_date = n.night\n        ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Loaded",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "Stopped: data checks failed",
                  "color": "red",
                  "index": 1
                },
                "0": {
                  "text": "No run",
                  "color": "#8e8e8e",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8e8e"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": false,
        "rowHeight": 0.9,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Why nights stopped",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Runs stopped by a data check, with the checks that failed (definitions in code/checks.sql and docs/02_DATA_CONTRACT.md).\n\n**Source:** n360.runs  \n**Filter:** stopped runs  \n**Window:** the latest 20",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT concat(toString(toDayOfMonth(data_date)), ' ', formatDateTime(data_date, '%b %Y')) AS Night, arrayStringConcat(checks_failed, ', ') AS `Checks failed`,\n               formatDateTime(loaded_at, '%e %b %Y %H:%i UTC') AS Attempted\n        FROM n360.runs WHERE status = 'failed_checks' ORDER BY loaded_at DESC, data_date DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No night has stopped"
        },
        "overrides": []
      },
      "options": {},
      "n360MayBeEmpty": "no night has stopped"
    },
    {
      "id": 8,
      "title": "Source freshness",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Each source's last day against the data-through day. Amber 2 days behind, red 3 (proposed, in n360.v_source_freshness).\n\n**Source:** n360.source via n360.v_source_freshness  \n**Filter:** none  \n**Window:** the latest load",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT source_id AS Source, description AS Description, concat(toString(toDayOfMonth(last_day)), ' ', formatDateTime(last_day, '%b %Y')) AS `Last day`,\n               days_behind AS `Days behind`, status AS Status\n        FROM n360.v_source_freshness ORDER BY days_behind DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "green": {
                        "text": "On time",
                        "color": "green",
                        "index": 0
                      },
                      "amber": {
                        "text": "Behind",
                        "color": "orange",
                        "index": 1
                      },
                      "red": {
                        "text": "Late",
                        "color": "red",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "Not reported yet",
                        "color": "#8e8e8e",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Source"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last day"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Days behind"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Days behind, night by night",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "How far each source's last day was behind the data-through day on every loaded night (0 = on time). Amber from 2, red from 3 (n360.settings).\n\n**Source:** n360.source_freshness (append-only, one row per source per night)  \n**Filter:** none  \n**Window:** dashboard time range, by night",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(data_date) AS time, source_id AS source, days_behind\n        FROM n360.source_freshness WHERE $__dateFilter(data_date) ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet",
          "decimals": 0,
          "min": 0,
          "displayName": "${__field.labels.source}",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {},
      "n360MayBeEmpty": "no night stored in the time range"
    },
    {
      "id": 9,
      "title": "Contract measure mix",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "How many contract lines are measured each way. Engaged = no contract rule applies (billable unit unconfirmed).\n\n**Source:** n360.contract_line  \n**Filter:** none  \n**Window:** the latest load",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT measure AS Measure, count() AS Lines FROM n360.contract_line GROUP BY measure ORDER BY Lines DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported yet"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Contract rules not live",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "n360-clickhouse"
      },
      "description": "Contract rules that are pending or blocked, so their lines are measured on engaged for now.\n\n**Source:** n360.rule  \n**Filter:** rules not active, or measuring no line  \n**Window:** the latest load",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "n360-clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT label AS Rule, status AS Status, counts_plain AS `What it would count`\n        FROM n360.rule WHERE status != 'active' OR empty(lines_measured)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Every rule is live"
        },
        "overrides": []
      },
      "options": {},
      "n360MayBeEmpty": "every rule is live"
    }
  ],
  "links": [
    {
      "type": "link",
      "title": "Back to Portfolio overview",
      "url": "/d/n360-overview",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "asDropdown": false,
      "tags": []
    }
  ]
}